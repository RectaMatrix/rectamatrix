{
  "name": "rectamatrix",
  "version": "0.1.0-preview.1",
  "description": "Experimental rectangular 2D barcode specification and TypeScript reference implementation.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RectaMatrix/rectamatrix.git"
  },
  "homepage": "https://github.com/RectaMatrix/rectamatrix#readme",
  "bugs": {
    "url": "https://github.com/RectaMatrix/rectamatrix/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "pnpm -r build",
    "compare:rm-hle1": "tsx scripts/compare-rmhle1.ts",
    "demo": "pnpm --filter @rectamatrix/browser-demo dev --host 127.0.0.1",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:spec": "tsx scripts/generate-spec-constants.ts",
    "generate:vectors": "pnpm build && tsx scripts/generate-vectors.ts",
    "verify:vectors": "pnpm build && tsx scripts/verify-vectors.ts",
    "verify:spec": "tsx scripts/verify-spec-constants.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm verify:spec && pnpm verify:vectors",
    "release:check": "pnpm check && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.26.0",
    "vitest": "^4.1.10"
  }
}
